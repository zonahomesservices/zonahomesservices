---
import { services } from '../data/services';
import { cities } from '../data/cities';
import { SITE } from '../data/site';
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <img class="foot-logo" src="/assets/logo-full.webp" width="625" height="603" alt="Zona Homes Services LLC, construction and cleaning" />
      <p class="slogan-sm">{SITE.slogan}</p>
      <a class="footer-phone" href={`tel:${SITE.phoneTel}`}>{SITE.phoneDisplay}</a>
      <p>Sebring, FL<br />Serving nearby cities within about 70 miles</p>
    </div>
    <div>
      <p class="footer-label">Services</p>
      <ul class="footer-list">
        {services.map((s) => <li><a href={`/services/${s.slug}/`}>{s.name}</a></li>)}
        <li><a href="/property-managers/">Property managers</a></li>
      </ul>
    </div>
    <div>
      <p class="footer-label">Areas</p>
      <ul class="footer-list">
        {cities.map((c) => <li><a href={`/areas/${c.slug}/`}>{c.name}, FL</a></li>)}
        <li><a href="/areas/">All areas we serve</a></li>
      </ul>
    </div>
    <div>
      <p class="footer-label">Company</p>
      <ul class="footer-list">
        <li><a href="/contact/">Contact and quotes</a></li>
        <li><a href="/review/">Leave a review</a></li>
        <li><a href="/privacy/">Privacy policy</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap footer-base">
    <p>&copy; 2026 Zona Homes Services LLC. All rights reserved.</p>
  </div>
</footer>
